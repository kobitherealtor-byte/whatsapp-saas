# Supabase public browser values
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server only. Never expose this value in NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY

# GREEN API Partner account - server only
GREEN_API_PARTNER_API_URL=https://api.green-api.com
GREEN_API_PARTNER_TOKEN=REPLACE_WITH_PARTNER_TOKEN

# Optional backwards-compatible key name if your project still uses the legacy anon key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...


# Shared secret used by Make when claiming and finalizing scheduled jobs.
# Generate a long random value and keep it server-side only.
AUTOMATION_SHARED_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET


# Make webhook used to recalculate and reactivate the one-shot worker.
MAKE_WAKE_WEBHOOK_URL=https://hook.eu1.make.com/REPLACE_ME
